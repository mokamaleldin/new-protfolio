# Optional: Production URL once custom domain is confirmed (e.g. https://mokamaleldin.com)
# Leave unset during preview deployments so temporary deployment URLs are used without assuming ownership of a TLD.
NEXT_PUBLIC_SITE_URL=

# Optional: Resend API Key for contact form server-side email delivery.
# When omitted, the contact form gracefully falls back to opening a prefilled mailto: link with full user disclosure.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=mohammed.kamal.eliwa@gmail.com
