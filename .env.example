# Set for Production on Vercel. Leave unset for Preview deployments.
NEXT_PUBLIC_SITE_URL=https://mokamaleldin.com

# Add secrets directly in Vercel Settings > Environment Variables; never commit them.
# Both RESEND_API_KEY and a sender on a verified Resend domain are required.
# Until configured, the form opens a disclosed, prefilled mailto link.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Contact <contact@mokamaleldin.com>
CONTACT_RECIPIENT_EMAIL=mohammed.kamal.eliwa@gmail.com
